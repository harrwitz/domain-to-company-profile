# Required: Google Gemini API key
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Override the default Gemini model (fallback list is built-in)
GEMINI_MODEL=gemini-3.8-flash

# Optional: Tavily API key for LinkedIn search fallback (bonus feature)
TAVILY_API_KEY=

# Optional: LLM concurrency and rate limit controls
LLM_CONCURRENCY=1
LLM_REQUEST_DELAY_SECONDS=2.0
